# ---- Impressora ----
# IP: tela da impressora -> Configuracoes (engrenagem) -> WLAN -> toque na rede conectada
PRINTER_IP=192.168.0.50
# Access Code: mesma tela do WLAN, campo "Access Code"
ACCESS_CODE=12345678
# Serial: Configuracoes -> Device -> Device Info (ou etiqueta embaixo da impressora)
SERIAL=00M00A000000000
# Modelo (usado so pra escolher a mensagem certa quando o texto de erro varia por impressora)
DEVICE_TYPE=A1

# Idioma preferido pro texto do erro (cai pro ingles se a traducao nao existir)
HMS_LANGUAGE=pt

# A partir de qual severidade notificar: info, common, serious, fatal
NOTIFY_MIN_SEVERITY=serious

# Marcos de progresso (%) pra notificar - "0,25,50,75,90,100" avisa em cada um
PROGRESS_MILESTONES=50,90

# ---- Notificacao: escolha UM canal (pode deixar os dois preenchidos, ele usa ambos) ----

# Opcao 1 - um servidor wwebjs-api (https://github.com/avoylenko/wwebjs-api) ja rodando
WHATSAPP_WEBHOOK_URL=http://localhost:3000/client/sendMessage/default
WHATSAPP_API_KEY=
WHATSAPP_CHAT_ID=5511999999999@c.us

# Opcao 2 - ntfy.sh (zero infra, so instalar o app ntfy no celular e assinar o topico)
# use uma string longa e aleatoria - quem souber o nome do topico consegue ler as mensagens
NTFY_TOPIC=

# ---- Banco externo (collect_status.py) ----
# Servidor MySQL/MariaDB externo, ex: o mesmo host onde fica o site/HTML
DB_HOST=mysql.seudominio.com
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASSWORD=
# desliga so se o host nao suportar TLS (nao recomendado - senha trafega aberta)
DB_SSL=true

# tempo (segundos) esperando reports depois do pushall antes de gravar
COLLECT_TIMEOUT=10
